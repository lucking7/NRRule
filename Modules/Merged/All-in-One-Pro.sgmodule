#!arguments = httpdns:,keli_filter:,amap:,sf_express:#,alipan:,xianyu:,kuwo:#,kugou_ring:#,kugou:#,kdocs:,tencent_docs:,caixin:#,pinduoduo:#,wechat_mp:,wechat_link:,wechat_miniapp:,weibo_lite:#,xiaoheihe:#,rail12306:,caiyun:,youku:#,wannianli:,qqmusic:,kook:#,xiaohongshu:,damai:#,quark:,bilibili_manga:#,ximalaya:,mgtv:#,cainiao:#,douyu:#,wuta_camera:,youdao_note:#,ezviz:,boohee:,umetrip:,meiyan:,netease_news:#,zhihu:#,zsxq:,baidu_map:,baidu_pan:,taobao:,taopiaopiao:#,didi:
#!arguments-desc = 模块开关：留空表示启用，填 # 表示停用。不常用的模块默认填 #，需要时清空即可启用。\n停用后，该模块在 Rule、URL Rewrite、Header Rewrite、Body Rewrite、Map Local、Script 中的所有行都会被注释掉。\nMITM 主机名不随开关变化，始终包含全部模块的主机名。\n源模块自带的参数仍然有效。\n\nhttpdns: HTTPDNS拦截器\nkeli_filter: 可莉广告过滤器\namap: 高德地图去广告\nsf_express: 顺丰速运去广告\nalipan: 阿里云盘去广告\nxianyu: 闲鱼去广告\nkuwo: 酷我音乐去广告\nkugou_ring: 酷狗铃声去广告\nkugou: 酷狗音乐去广告\nkdocs: 金山文档去广告\ntencent_docs: 腾讯文档去广告\ncaixin: 财新去广告\npinduoduo: 拼多多去广告\nwechat_mp: 微信公众号去广告\nwechat_link: 微信外部链接解锁\nwechat_miniapp: 微信小程序去广告\nweibo_lite: 微博轻享版去广告\nxiaoheihe: 小黑盒去广告\nrail12306: 12306去广告\ncaiyun: 彩云天气去广告\nyouku: 优酷视频去广告\nwannianli: 中华万年历去广告\nqqmusic: QQ音乐去广告\nkook: KOOK去广告\nxiaohongshu: 小红书去广告\ndamai: 大麦去广告\nquark: 夸克去广告\nbilibili_manga: 哔哩哔哩漫画去广告\nximalaya: 喜马拉雅去广告\nmgtv: 芒果TV去广告\ncainiao: 菜鸟去广告\ndouyu: 斗鱼去广告\nwuta_camera: 无他相机去广告\nyoudao_note: 有道云笔记去广告\nezviz: 萤石云视频去广告\nboohee: 薄荷健康去广告\numetrip: 航旅纵横去广告\nmeiyan: 美颜相机去广告\nnetease_news: 网易新闻去广告\nzhihu: 知乎去广告\nzsxq: 知识星球去水印\nbaidu_map: 百度地图去广告\nbaidu_pan: 百度网盘去广告\ntaobao: 淘宝去广告\ntaopiaopiao: 淘票票去广告\ndidi: 滴滴出行去广告

[Rule]
# ---------- HTTPDNS拦截器 ----------

{{{httpdns}}}DOMAIN-KEYWORD,httpdns,REJECT
{{{httpdns}}}DOMAIN-KEYWORD,httpsdns,REJECT
{{{httpdns}}}USER-AGENT,"httpdns*",REJECT
{{{httpdns}}}USER-AGENT,"httpsdns*",REJECT
{{{httpdns}}}USER-AGENT,"Httpdns*",REJECT
{{{httpdns}}}USER-AGENT,"Httpsdns*",REJECT
{{{httpdns}}}AND,((URL-REGEX,"^http:\/\/119\.29\.29\.90\/d\?"),(USER-AGENT,"%E5%98%80%E5%97%92%E5%87%BA%E8%A1%8C*")),DIRECT
{{{httpdns}}}AND,((URL-REGEX,"^http:\/\/119\.28\.28\.90\/d\?"),(USER-AGENT,"%E5%98%80%E5%97%92%E5%87%BA%E8%A1%8C*")),DIRECT
{{{httpdns}}}URL-REGEX,"^http:\/\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)(?:\/v?[0-9]+)?\/(?:sign_)?(?:(?:d|ss)[46]?|resolve)\?",REJECT
{{{httpdns}}}URL-REGEX,"^http:\/\/\[[0-9a-fA-F:]+\](?:\/v?[0-9]+)?\/(?:sign_)?(?:(?:d|ss)[46]?|resolve)\?",REJECT
