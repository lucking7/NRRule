{{{YouTube去广告}}}m_d97b7579df007ec8_2_请求初始化 = type=http-request, pattern=(?i)^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*, script-path=https://nrrule.pages.dev/Scripts/a8704cadd8f8-YouTube_remove_ads_request.js, requires-body=true, binary-body-mode=true, argument=captionLang="{{{m_d97b7579df007ec8_captionLang}}}"
{{{YouTube去广告}}}m_d97b7579df007ec8_3_请求日志事件 = type=http-request, pattern=(?i)^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event, script-path=https://nrrule.pages.dev/Scripts/a8704cadd8f8-YouTube_remove_ads_request.js, requires-body=true, binary-body-mode=true, argument=blockUpload="{{{m_d97b7579df007ec8_blockUpload}}}"&blockShorts="{{{m_d97b7579df007ec8_blockShorts}}}"&blockImmersive="{{{m_d97b7579df007ec8_blockImmersive}}}"&captionLang="{{{m_d97b7579df007ec8_captionLang}}}"&debug="{{{m_d97b7579df007ec8_debug}}}"

